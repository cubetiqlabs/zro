# ZRO environment variables (used by docker-compose*.yml). Copy to .env and fill in.
# Generate secrets with:  openssl rand -hex 32

# --- Required --------------------------------------------------------------------------
# Signs enrollment tokens. Compose refuses to start without it.
CLUSTER_SECRET=
# Shared key an edge uses for its first registration of a PoP (it is then issued its own
# credential). Compose refuses to start without it.
EDGE_API_KEY=
# Bootstrap key for tenant administration and /metrics.
ADMIN_API_KEY=

# --- PostgreSQL (control plane) ----------------------------------------------------------
POSTGRES_USER=zro
POSTGRES_PASSWORD=choose_a_strong_database_password
POSTGRES_DB=zro
POSTGRES_PORT=5432
DATABASE_DSN=postgres://zro:choose_a_strong_database_password@localhost:5432/zro?sslmode=disable

# --- Control plane -----------------------------------------------------------------------
PUBLIC_URL=https://zro-plane.cubis.tech:443
LOG_LEVEL=info
# true = tenant endpoints need a tenant API key (use true in production).
CONTROL_PLANE_REQUIRE_AUTH=true
# Hours a silent node is kept before it is removed and its address freed (0 = never).
NODE_TTL=168h
# gRPC is off unless a listen address is set. Use TLS (cert + key paths inside the container);
# only set GRPC_INSECURE=true behind a TLS-terminating proxy.
GRPC_LISTEN_ADDR=
GRPC_TLS_CERT=
GRPC_TLS_KEY=
GRPC_INSECURE=false

# --- Edge PoP (standalone edge servers) --------------------------------------------------
POP_CODE=KH
REGION=Asia/Phnom_Penh
PUBLIC_ENDPOINT=173.1.1.1:51820
LISTEN_PORT=51820
INTERFACE_NAME=zro-edge
PLANE_ENDPOINT=https://zro-plane.cubis.tech:443
PLANE_TRANSPORT=rest
IS_ANYCAST=false

# --- Ingress gateway ---------------------------------------------------------------------
# Mint once the plane is up:  zro token --secret $CLUSTER_SECRET --network-id <id> --hostname gw1 --type gateway
# Without a token the gateway serves only static routes and never joins the mesh.
GATEWAY_ENROLLMENT_TOKEN=
GATEWAY_INTERFACE_NAME=zro-gw
GATEWAY_LISTEN_PORT=0
GATEWAY_PORT=8080
GATEWAY_DOMAIN=cubis.tech
AUTO_TLS=false

# --- Client node -------------------------------------------------------------------------
NODE_INTERFACE_NAME=zro0
NODE_LISTEN_PORT=0
ENROLLMENT_TOKEN=zro_tok_...
NETWORK_ID=8056c2e21c000001
