# ZRO Production Environment Variables

# Cluster Secret (used for node enrollment HMAC tokens)
CLUSTER_SECRET=generate-a-secure-random-secret-key-32-chars

# PostgreSQL Database (for Control Plane)
POSTGRES_USER=zro
POSTGRES_PASSWORD=choose_a_strong_database_password
POSTGRES_DB=zro
POSTGRES_PORT=5432
DATABASE_DSN=postgres://zro:choose_a_strong_database_password@localhost:5432/zro?sslmode=disable

# Control Plane Settings
PUBLIC_URL=https://zro-plane.cubis.tech:443
LOG_LEVEL=info

# Edge Data Plane PoP Settings (for standalone edge servers)
POP_CODE=KH
REGION=Asia/Phnom_Penh
PUBLIC_ENDPOINT=173.1.1.1:51820
LISTEN_PORT=51820
INTERFACE_NAME=zro-edge
PLANE_ENDPOINT=https://zro-plane.cubis.tech:443
PLANE_TRANSPORT=rest
EDGE_API_KEY=
IS_ANYCAST=false

# Ingress Gateway Settings
GATEWAY_INTERFACE_NAME=zro-gw
GATEWAY_LISTEN_PORT=0
GATEWAY_PORT=8080
GATEWAY_DOMAIN=cubis.tech
AUTO_TLS=false

# Client Node Settings
NODE_INTERFACE_NAME=zro0
NODE_LISTEN_PORT=0
ENROLLMENT_TOKEN=zro_tok_...
NETWORK_ID=8056c2e21c000001

# Control Plane Auth (set a non-empty edge API key and require it in production)
CONTROL_PLANE_REQUIRE_AUTH=false
CONTROL_PLANE_EDGE_API_KEY=
